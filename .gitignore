/target
**/*.rs.bk
# Local-only scratch space — holds signing/notary credentials, never commit.
/ignore/
*.pdb
.DS_Store
.env
.env.local
node_modules
.wrangler
build/
edge/dist/
# Fork: shared skills live in .agents; other local agent state stays out.
.agents/*
!.agents/skills/
.claude/*
!.claude/skills
CLAUDE.md
/scripts/**/__pycache__/
.dev.vars
.dev.vars.*
