/target
**/*.rs.bk
# Local-only scratch space — holds signing/notary credentials, never commit.
/ignore/
*.pdb
.DS_Store
.env
.env.local
node_modules
.wrangler
build/
edge/dist/
.agents
# Fork: local agent state stays out, but this fork's shared skills are tracked.
.claude/*
!.claude/skills/
CLAUDE.md
/scripts/**/__pycache__/
.dev.vars
.dev.vars.*
